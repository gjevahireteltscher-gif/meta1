{
  "schema_version": "contextual-language-rules-2",
  "action_role_source": {
    "hard_requirements": "data/predicates.tsv",
    "selectional_preferences": "data/verbnet-action-roles.tsv",
    "policy": "prefer-hard-else-disjoin-compiled-preferences"
  },
  "bridge_relation_source": "requirement-sort-map-filtered-by-snapshot",
  "bridge_relations_by_sort": {
    "Agent": ["InstitutionOf", "GovernedBy", "AffiliatedWith"],
    "Animate": ["InstitutionOf", "AffiliatedWith"],
    "Organization": ["InstitutionOf", "AffiliatedWith"],
    "Readable": ["Authored", "Created"],
    "Wearable": ["Produces", "Created"],
    "Clothing": ["Produces", "Created"],
    "Edible": ["Contains", "Produces"],
    "Drinkable": ["Contains", "Produces"],
    "Product": ["Produces", "Created"],
    "Producer": ["ProducedBy", "Created"]
  },
  "max_bridge_depth": 1,
  "morphology_overrides": {
    "announce": {
      "forms": ["announce", "announced", "announces"],
      "gf_form": "announces"
    },
    "read": {
      "forms": ["read", "reads"],
      "gf_form": "reads"
    },
    "sign": {
      "forms": ["sign", "signed", "signs"],
      "gf_form": "signs"
    },
    "wear": {
      "forms": ["wear", "wears", "wore"],
      "gf_form": "wears"
    }
  },
  "lexical_sorts": {
    "book": {"requirement": "HasSort Readable", "provenance": "WordNet:book.n.01"},
    "clothing": {"requirement": "HasSort Clothing", "provenance": "WordNet:clothing.n.01"},
    "physics": {"requirement": "HasSort ScientificDiscipline", "provenance": "WordNet:physics.n.01"},
    "programme": {"requirement": "AnyOf [HasSort Programme,HasSort ResearchProgramme]", "provenance": "WordNet:program.n.08"}
  },
  "context_templates": [
    {
      "construction": "ModifyNP+InPP",
      "head_sorts": ["Programme", "ResearchProgramme"],
      "relation": "Conducts",
      "target_slot": "modifier",
      "provenance": "context-template:programme-in-topic:v1"
    }
  ],
  "composition_matrix": [
    {
      "modifier_sort": "Political",
      "noun_sort": "Agreement",
      "result_sort": "PoliticalAgreement",
      "provenance": "ontology-composition:Political×Agreement"
    },
    {
      "modifier_sort": "Commercial",
      "noun_sort": "Agreement",
      "result_sort": "CommercialAgreement",
      "provenance": "ontology-composition:Commercial×Agreement"
    }
  ],
  "action_object_requirements": {
    "sign": {
      "Agreement": {
        "candidate_requirement": "HasSort Agent",
        "provenance": "FrameNet:Sign_agreement:Signer"
      },
      "PoliticalAgreement": {
        "candidate_requirement": "AnyOf [HasSort Government,HasSort PoliticalOrganization]",
        "provenance": "FrameNet:Political_agreement:Signatory"
      },
      "CommercialAgreement": {
        "candidate_requirement": "HasSort BusinessOrganization",
        "provenance": "FrameNet:Commercial_agreement:Signatory"
      }
    }
  }
}
